{
	"name": "webtions/grid-overlay",
	"type": "wordpress-plugin",
	"description": "Figma-style visual grid overlay for testing alignment and spacing on the frontend.",
	"keywords": ["WordPress", "Plugin", "Grid", "Overlay"],
	"homepage": "https://github.com/webtions/grid-overlay",
	"license": "GPL-3.0-or-later",
	"require": {
	  "php": ">=8.2"
	},
	"require-dev": {
	  "php-parallel-lint/php-parallel-lint": "^1.3",
	  "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
	  "wp-coding-standards/wpcs": "^3.0",
	  "phpstan/phpstan": "^2.1",
	  "szepeviktor/phpstan-wordpress": "^2.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"scripts": {
	  "lint": "parallel-lint --exclude vendor .",
	  "standards:check": "phpcs",
	  "standards:fix": "phpcbf",
	  "analyze": "phpstan analyze --memory-limit=512M"
	},
	"config": {
	  "allow-plugins": {
		"dealerdirect/phpcodesniffer-composer-installer": true
	  }
	}
  }
